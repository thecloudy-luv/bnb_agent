# Campaign wallet private key (hex format, never commit your real key)
PRIVATE_KEY=

# RPC URL for BSC network (defaults to BSC Testnet)
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# Chain ID (97 for BSC Testnet, 56 for BSC Mainnet)
CHAIN_ID=97

# Public base URL of the agent service (auto-configured by RENDER_EXTERNAL_URL if deployed on Render)
PUBLIC_BASE_URL=http://localhost:8000

# Background automation loops flag (0: disabled for local development/testing, 1: enabled on production server only)
RUN_LOOPS=0

# RPC URL for eth_getLogs queries (defaults to PublicNode BSC Testnet)
RPC_LOGS_URL=https://bsc-testnet-rpc.publicnode.com

# Pinata IPFS JWT for uploading job deliverables
STORAGE_API_KEY=

# Block number to start scanning for JobFunded events (optional)
JOB_SCAN_FROM_BLOCK=

# Comma-separated list of client addresses to exclude from campaign stats (e.g. self, test checkers)
EXCLUDED_CLIENTS=

# ERC-8183 Rate Limiting for negotiation endpoint
ERC8183_NEGOTIATE_RATE_LIMIT=10
ERC8183_NEGOTIATE_GLOBAL_RATE_LIMIT=100
ERC8183_NEGOTIATE_RATE_WINDOW=60.0

